# 监听地址与端口
BANOSS_HOST=0.0.0.0
BANOSS_PORT=9000

# 数据目录（存放 banoss.db / .master.key / .admin.token）
BANOSS_DATA_DIR=./data

# 建议显式固定管理员 Token 与 32 字节主密钥（留空则首次启动自动生成并持久化到 data 目录）
# BANOSS_ADMIN_TOKEN=change-me-strong-token
# BANOSS_MASTER_KEY=

# 用于识别 Virtual-Hosted Style 请求（如 bucket.oss.example.com）
BANOSS_BASE_DOMAINS=["localhost","127.0.0.1"]

# 透明加密分块大小（默认 1 MiB）与 SFTP 空闲断连超时（秒）
BANOSS_CHUNK_SIZE=1048576
BANOSS_SFTP_IDLE_TIMEOUT=60
